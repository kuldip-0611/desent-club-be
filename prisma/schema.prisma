generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProviderType {
  GOOGLE
  EMAIL
  PHONE
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum ProductAudience {
  MEN
  WOMEN
  UNISEX
}

model Fabric {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productFabrics ProductFabric[]

  @@index([isActive])
  @@index([sortOrder])
}

model ProductFabric {
  id        String  @id @default(uuid())
  productId String
  fabricId  String
  percent   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric    Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@unique([productId, fabricId])
  @@index([productId])
  @@index([fabricId])
}

model ProductCategory {
  id             String                       @id @default(uuid())
  slug           String                       @unique
  name           String
  image          String?
  isActive       Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  products       Product[]
  couponLinks    CouponCategory[]
  subcategories  ProductCategorySubcategory[]

  @@index([isActive])
}

model ProductCategorySubcategory {
  id         String          @id @default(uuid())
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  image      String?
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  products   Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String?            @unique
  phone             String?            @unique
  profileImage      String?
  password          String?
  role              UserRole           @default(USER)
  isVerified        Boolean            @default(false)
  provider          AuthProviderType
  refreshToken      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  authProviders     AuthProvider[]
  groupMemberships  UserGroupMember[]
  couponAssignments CouponUser[]
  couponRedemptions CouponRedemption[]
  passwordResetTokens PasswordResetToken[]
  fcmToken            String?
  addresses           UserAddress[]
  orders              Order[]
  productReviews      ProductReview[]
  returnRequests      ReturnRequest[]
  notifications       Notification[]
  wishlistItems       WishlistItem[]
  abandonedCart       AbandonedCart?

  @@index([role])
}

model UserAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserGroup {
  id          String              @id @default(uuid())
  name        String
  description String?             @db.Text
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     UserGroupMember[]
  couponLinks CouponUserGroup[]

  @@index([isActive])
}

model UserGroupMember {
  id          String    @id @default(uuid())
  userGroupId String
  userId      String
  createdAt   DateTime  @default(now())
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, userId])
  @@index([userId])
}

model CouponUser {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model CouponUserGroup {
  id          String    @id @default(uuid())
  couponId    String
  userGroupId String
  createdAt   DateTime  @default(now())
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([couponId, userGroupId])
  @@index([userGroupId])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
}

model Otp {
  id         String   @id @default(uuid())
  identifier String
  otp        String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([identifier, isUsed, expiresAt])
}

model AuthProvider {
  id         String           @id @default(uuid())
  userId     String
  provider   AuthProviderType
  providerId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId, provider])
}

// Maps to legacy `basePrice` / `imageUrl` columns. quantity = total stock (sum of variants when variants exist).
model Product {
  id            String           @id @default(uuid())
  name          String
  description   String?          @db.Text
  price         Decimal          @map("basePrice") @db.Decimal(10, 2)
  quantity      Int              @default(0)
  audience      ProductAudience  @default(UNISEX)
  color         String           @default("")
  fabric        String           @default("")
  /** 1–100 = percentage off list `price`; null = no discount */
  discountPercent Int?
  isAvailable   Boolean          @default(true)
  categoryId     String?
  category       ProductCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    ProductCategorySubcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  productTypeId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        ProductImage[]
  variants      ProductVariant[]
  productFabrics ProductFabric[]
  productMeasurementAttributes ProductMeasurementAttribute[]
  orderItems    OrderItem[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isAvailable])
  @@index([createdAt])
  @@index([audience])
}

model ProductMeasurementAttribute {
  id          String               @id @default(uuid())
  productId   String
  attributeId String
  sortOrder   Int                  @default(0)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   MeasurementAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  size       String   @db.VarChar(32)
  color      String   @default("")
  sizeId     String?
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogSize Size?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  @@unique([productId, size, color])
  @@index([productId])
  @@index([sizeId])
}

// Dynamic measurement keys (chest, length, shoulder, inseam, …). Not every size uses every attribute.
model MeasurementAttribute {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  label       String
  unit        String?
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  sizeValues  SizeMeasurementValue[]
  productUses ProductMeasurementAttribute[]

  @@index([isActive])
  @@index([sortOrder])
}

// Master size row (e.g. M, L, 32). Measurements are sparse: only attributes that apply.
model Size {
  id                String                 @id @default(uuid())
  code              String                 @unique
  name              String?
  sortOrder         Int                    @default(0)
  /** Optional: typical unit for numeric values in this size chart (cm or in) */
  valueUnit         String?                @db.VarChar(4)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  measurementValues SizeMeasurementValue[]
  productVariants   ProductVariant[]

  @@index([isActive])
  @@index([sortOrder])
}

model SizeMeasurementValue {
  id          String               @id @default(uuid())
  sizeId      String
  attributeId String
  value       String               @db.VarChar(64)
  size        Size                 @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  attribute   MeasurementAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([sizeId, attributeId])
  @@index([sizeId])
  @@index([attributeId])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  path       String   @map("imageUrl")
  color      String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  discountType   CouponDiscountType
  value          Decimal            @db.Decimal(10, 2)
  minSubtotal    Decimal?           @db.Decimal(10, 2)
  maxDiscount    Decimal?           @db.Decimal(10, 2)
  usageLimit     Int?
  perUserLimit   Int?
  usedCount      Int                @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  categoryLinks  CouponCategory[]
  userLinks      CouponUser[]
  userGroupLinks CouponUserGroup[]
  redemptions    CouponRedemption[]
  orders         Order[]

  @@index([isActive])
  @@index([endsAt])
}

model CouponCategory {
  id         String          @id @default(uuid())
  couponId   String
  categoryId String
  coupon     Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddressId String?
  shippingAddress   Json?
  notes             String?     @db.Text
  cancelReason      String?     @db.Text
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  shiprocketOrderId String?
  awbCode           String?
  courierName       String?
  trackingUrl       String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  payment           Payment?
  returnRequests    ReturnRequest[]
  reviews           ProductReview[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String       @db.Text
  type         ReturnType   @default(RETURN)
  orderItemId  String?
  exchangeSize String?      @db.VarChar(64)
  status       ReturnStatus @default(REQUESTED)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([type])
}

model ProductReview {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, orderItemId])
  @@index([productId])
  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  size      String  @default("")
  color     String  @default("")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                  String         @id @default(uuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method              PaymentMethod  @default(ONLINE)
  razorpayOrderId     String         @unique
  razorpayPaymentId   String?        @unique
  razorpaySignature   String?
  razorpayRefundId    String?
  amount              Int
  currency            String         @default("INR")
  status              PaymentStatus  @default(PENDING)
  failureReason       String?
  refundedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([method])
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─── Abandoned Cart ───────────────────────────────────────────────────────────
model AbandonedCart {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json
  emailSentAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([updatedAt])
}
