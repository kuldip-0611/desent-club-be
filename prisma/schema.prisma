generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProviderType {
  GOOGLE
  EMAIL
  PHONE
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum ProductAudience {
  MEN
  WOMEN
  UNISEX
}

model Fabric {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productFabrics ProductFabric[]

  @@index([isActive])
  @@index([sortOrder])
}

model ProductFabric {
  id        String  @id @default(uuid())
  productId String
  fabricId  String
  percent   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric    Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@unique([productId, fabricId])
  @@index([productId])
  @@index([fabricId])
}

model ProductCategory {
  id             String                       @id @default(uuid())
  slug           String                       @unique
  name           String
  image          String?
  isActive       Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  products       Product[]
  couponLinks    CouponCategory[]
  subcategories  ProductCategorySubcategory[]

  @@index([isActive])
}

model ProductCategorySubcategory {
  id         String          @id @default(uuid())
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  image      String?
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  products   Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String?            @unique
  phone             String?            @unique
  profileImage      String?
  password          String?
  role              UserRole           @default(USER)
  isVerified        Boolean            @default(false)
  provider          AuthProviderType
  refreshToken      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  authProviders     AuthProvider[]
  groupMemberships  UserGroupMember[]
  couponAssignments CouponUser[]
  couponRedemptions CouponRedemption[]
  passwordResetTokens PasswordResetToken[]
  fcmToken            String?
  addresses           UserAddress[]
  orders              Order[]
  productReviews      ProductReview[]
  returnRequests      ReturnRequest[]
  notifications       Notification[]
  wishlistItems       WishlistItem[]
  abandonedCart       AbandonedCart?
  backInStockAlerts   BackInStockAlert[]
  npsSurveyResponses  NpsSurveyResponse[]
  loyaltyAccount      LoyaltyAccount?
  storeCredit         StoreCredit?
  referralCode        ReferralCode?
  referral            Referral?           @relation("ReferredUser")
  purchasedGiftCards  GiftCard[]          @relation("PurchasedGiftCards")

  @@index([role])
}

model UserAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserGroup {
  id          String              @id @default(uuid())
  name        String
  description String?             @db.Text
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     UserGroupMember[]
  couponLinks CouponUserGroup[]

  @@index([isActive])
}

model UserGroupMember {
  id          String    @id @default(uuid())
  userGroupId String
  userId      String
  createdAt   DateTime  @default(now())
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, userId])
  @@index([userId])
}

model CouponUser {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model CouponUserGroup {
  id          String    @id @default(uuid())
  couponId    String
  userGroupId String
  createdAt   DateTime  @default(now())
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([couponId, userGroupId])
  @@index([userGroupId])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
}

model Otp {
  id         String   @id @default(uuid())
  identifier String
  otp        String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([identifier, isUsed, expiresAt])
}

model AuthProvider {
  id         String           @id @default(uuid())
  userId     String
  provider   AuthProviderType
  providerId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId, provider])
}

// Maps to legacy `basePrice` / `imageUrl` columns. quantity = total stock (sum of variants when variants exist).
model Product {
  id            String           @id @default(uuid())
  name          String
  description   String?          @db.Text
  price         Decimal          @map("basePrice") @db.Decimal(10, 2)
  quantity      Int              @default(0)
  audience      ProductAudience  @default(UNISEX)
  color         String           @default("")
  fabric        String           @default("")
  /** 1–100 = percentage off list `price`; null = no discount */
  discountPercent Int?
  isAvailable   Boolean          @default(true)
  slug           String?          @unique @db.VarChar(256)
  gstRate        Decimal          @default(0.18) @db.Decimal(4, 4)
  metaTitle      String?          @db.VarChar(256)
  metaDescription String?         @db.VarChar(512)
  categoryId     String?
  category       ProductCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    ProductCategorySubcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  productTypeId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        ProductImage[]
  variants      ProductVariant[]
  productFabrics ProductFabric[]
  productMeasurementAttributes ProductMeasurementAttribute[]
  orderItems    OrderItem[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  backInStockAlerts BackInStockAlert[]
  bundles       BundleProduct[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isAvailable])
  @@index([createdAt])
  @@index([audience])
}

model ProductMeasurementAttribute {
  id          String               @id @default(uuid())
  productId   String
  attributeId String
  sortOrder   Int                  @default(0)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   MeasurementAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  size       String   @db.VarChar(32)
  color      String   @default("")
  sizeId     String?
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogSize Size?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  @@unique([productId, size, color])
  @@index([productId])
  @@index([sizeId])
}

// Dynamic measurement keys (chest, length, shoulder, inseam, …). Not every size uses every attribute.
model MeasurementAttribute {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  label       String
  unit        String?
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  sizeValues  SizeMeasurementValue[]
  productUses ProductMeasurementAttribute[]

  @@index([isActive])
  @@index([sortOrder])
}

// Master size row (e.g. M, L, 32). Measurements are sparse: only attributes that apply.
model Size {
  id                String                 @id @default(uuid())
  code              String                 @unique
  name              String?
  sortOrder         Int                    @default(0)
  /** Optional: typical unit for numeric values in this size chart (cm or in) */
  valueUnit         String?                @db.VarChar(4)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  measurementValues SizeMeasurementValue[]
  productVariants   ProductVariant[]

  @@index([isActive])
  @@index([sortOrder])
}

model SizeMeasurementValue {
  id          String               @id @default(uuid())
  sizeId      String
  attributeId String
  value       String               @db.VarChar(64)
  size        Size                 @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  attribute   MeasurementAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([sizeId, attributeId])
  @@index([sizeId])
  @@index([attributeId])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  path       String   @map("imageUrl")
  color      String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  discountType   CouponDiscountType
  value          Decimal            @db.Decimal(10, 2)
  minSubtotal    Decimal?           @db.Decimal(10, 2)
  maxDiscount    Decimal?           @db.Decimal(10, 2)
  usageLimit     Int?
  perUserLimit   Int?
  usedCount      Int                @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  categoryLinks  CouponCategory[]
  userLinks      CouponUser[]
  userGroupLinks CouponUserGroup[]
  redemptions    CouponRedemption[]
  orders         Order[]

  @@index([isActive])
  @@index([endsAt])
}

model CouponCategory {
  id         String          @id @default(uuid())
  couponId   String
  categoryId String
  coupon     Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([couponId])
  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnRefundMethod {
  BANK         // refund to original payment method (5-7 days)
  STORE_CREDIT // instant store credit added to account
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  EXCHANGED   // exchange item dispatched to customer (only for type=EXCHANGE)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddressId String?
  shippingAddress   Json?
  notes             String?     @db.Text
  cancelReason          String?     @db.Text
  cancelVariantChange   Boolean     @default(false)
  requestedSize         String?     @db.VarChar(20)
  requestedColor        String?     @db.VarChar(100)
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  shiprocketOrderId String?
  awbCode           String?
  courierName       String?
  trackingUrl       String?     @db.Text
  gstRate           Decimal     @default(0.18) @db.Decimal(4, 4)
  cgst              Decimal     @default(0) @db.Decimal(10, 2)
  sgst              Decimal     @default(0) @db.Decimal(10, 2)
  igst              Decimal     @default(0) @db.Decimal(10, 2)
  taxableAmount     Decimal     @default(0) @db.Decimal(10, 2)
  affiliateCode     String?     @db.VarChar(64)
  codOtp            String?
  codOtpVerified    Boolean     @default(false)
  codOtpExpiresAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  payment           Payment?
  returnRequests    ReturnRequest[]
  reviews           ProductReview[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ReturnRequest {
  id           String             @id @default(uuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String             @db.Text
  type         ReturnType         @default(RETURN)
  refundMethod ReturnRefundMethod @default(BANK)
  orderItemId  String?
  exchangeSize String?            @db.VarChar(64)
  status       ReturnStatus       @default(REQUESTED)
  refundAmount Decimal?           @db.Decimal(10, 2)
  adminNote    String?            @db.Text

  // Shiprocket reverse pickup (created when admin approves)
  returnShiprocketOrderId String? @db.VarChar(64)
  returnShipmentId        String? @db.VarChar(64)
  returnAwbCode           String? @db.VarChar(64)
  returnCourierName       String? @db.VarChar(128)

  // Shiprocket forward shipment for exchange (created when exchange item dispatched)
  exchangeShiprocketOrderId String? @db.VarChar(64)
  exchangeShipmentId        String? @db.VarChar(64)
  exchangeAwbCode           String? @db.VarChar(64)
  exchangeCourierName       String? @db.VarChar(128)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([type])
}

model ProductReview {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  rating      Int
  comment     String?      @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, orderItemId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  size      String  @default("")
  color     String  @default("")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                  String         @id @default(uuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method              PaymentMethod  @default(ONLINE)
  razorpayOrderId     String         @unique
  razorpayPaymentId   String?        @unique
  razorpaySignature   String?
  razorpayRefundId    String?
  amount              Int
  currency            String         @default("INR")
  status              PaymentStatus  @default(PENDING)
  failureReason       String?
  refundedAt          DateTime?
  /** For COD orders: date the courier remitted cash to the business */
  codRemittedAt       DateTime?
  /** Shiprocket remittance reference (if available) */
  codRemittanceRef    String?        @db.VarChar(128)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([method])
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─── Abandoned Cart ───────────────────────────────────────────────────────────
model AbandonedCart {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json
  emailSentAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([updatedAt])
}

// ─── Webhook Idempotency ───────────────────────────────────────────────────────
model ProcessedWebhookEvent {
  id          String   @id // Razorpay event id (e.g. pay_xxx or rfnd_xxx)
  source      String   @default("razorpay") // razorpay | shiprocket
  processedAt DateTime @default(now())

  @@index([source])
}

// ─── Back-in-Stock Alerts ─────────────────────────────────────────────────────
model BackInStockAlert {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  size       String?   @db.VarChar(32)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email, size])
  @@index([productId])
  @@index([notifiedAt])
}

// ─── Banners / Homepage CMS ───────────────────────────────────────────────────
model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String    @db.Text
  linkUrl   String?   @db.Text
  position  String    @default("hero") // hero | mid | footer
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position, isActive])
  @@index([startsAt, endsAt])
}

// ─── Flash Sales ──────────────────────────────────────────────────────────────
model FlashSale {
  id              String   @id @default(uuid())
  title           String
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  productIds      Json // string[] of product IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startsAt, endsAt])
  @@index([isActive])
}

// ─── NPS Survey ───────────────────────────────────────────────────────────────
model NpsSurveyResponse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  score     Int // 0-10
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([score])
}

// ─── Product Bundles / Combos ─────────────────────────────────────────────────

model Bundle {
  id            String          @id @default(uuid())
  name          String
  description   String?
  discountType  String          @default("PERCENT") // PERCENT | FLAT
  discountValue Decimal         @db.Decimal(10, 2)
  minItems      Int             @default(2)
  isActive      Boolean         @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  products      BundleProduct[]

  @@index([isActive])
}

model BundleProduct {
  id        String  @id @default(uuid())
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
}

// ─── Affiliate / UTM Tracking ─────────────────────────────────────────────────
model AffiliateClick {
  id        String   @id @default(uuid())
  code      String // affiliate/UTM code
  source    String? // utm_source
  medium    String? // utm_medium
  campaign  String? // utm_campaign
  ip        String?  @db.VarChar(64)
  orderId   String? // set when click leads to order
  userId    String?
  createdAt DateTime @default(now())

  @@index([code])
  @@index([orderId])
}

// ── Loyalty Points ────────────────────────────────────────────────────────────

// Singleton — only one row ever (id = "singleton")
model LoyaltySetting {
  id                  String   @id @default("singleton")
  pointsPerRupee      Float    @default(1)
  rupeePerPoint       Float    @default(0.25)
  minRedeemPoints     Int      @default(100)
  maxRedeemPercent    Int      @default(20)
  referralBonus       Int      @default(100)
  referredBonus       Int      @default(50)
  orderEarnMultiplier Float    @default(1)
  updatedAt           DateTime @updatedAt
}

model LoyaltyAccount {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int            @default(0)
  totalEarned  Int            @default(0)
  totalRedeemed Int           @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String           @id @default(uuid())
  accountId   String
  account     LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LoyaltyTxType
  points      Int
  description String
  orderId     String?
  createdAt   DateTime         @default(now())

  @@index([accountId])
  @@index([orderId])
}

enum LoyaltyTxType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
  REFERRAL
  ADJUSTED
}

// ── Referral Program ──────────────────────────────────────────────────────────

model ReferralCode {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String      @unique @db.VarChar(20)
  timesUsed   Int         @default(0)
  createdAt   DateTime    @default(now())
  referrals   Referral[]
}

model Referral {
  id             String       @id @default(uuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredUserId String       @unique
  referredUser   User         @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  orderId        String?
  rewardGiven    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([referralCodeId])
}

// ── Store Credit ──────────────────────────────────────────────────────────────

model StoreCredit {
  id           String               @id @default(uuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal              @default(0) @db.Decimal(10, 2)
  totalEarned  Decimal              @default(0) @db.Decimal(10, 2)
  totalUsed    Decimal              @default(0) @db.Decimal(10, 2)
  transactions StoreCreditTx[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model StoreCreditTx {
  id          String      @id @default(uuid())
  creditId    String
  credit      StoreCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(10, 2)
  type        StoreCreditTxType
  description String      @db.VarChar(300)
  returnId    String?
  orderId     String?
  createdAt   DateTime    @default(now())

  @@index([creditId])
}

enum StoreCreditTxType {
  EARNED   // credit added from return
  USED     // credit applied at checkout
  EXPIRED  // unused credit expired
  ADJUSTED // manual admin adjustment
}

// ── Gift Cards ────────────────────────────────────────────────────────────────

model GiftCard {
  id                String    @id @default(uuid())
  code              String    @unique @db.VarChar(20)
  initialAmount     Decimal   @db.Decimal(10, 2)
  balance           Decimal   @db.Decimal(10, 2)
  purchasedById     String?
  purchasedBy       User?     @relation("PurchasedGiftCards", fields: [purchasedById], references: [id], onDelete: SetNull)
  recipientEmail    String
  recipientName     String?
  message           String?
  isActive          Boolean   @default(false)
  isPaid            Boolean   @default(false)
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  redeemedAt        DateTime?

  @@index([code])
  @@index([purchasedById])
  @@index([razorpayOrderId])
}

// ── Cancellation Reasons (Admin-managed) ─────────────────────────────────────

model CancellationReason {
  id        String   @id @default(uuid())
  label     String   @db.VarChar(200)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
